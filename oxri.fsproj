<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile shared views first, then page views, then the application entry point. -->
    <Compile Include="Views/Page.fs" />
    <Compile Include="Views/Misc/Back.fs" />
    <Compile Include="Views/Landing.fs" />
    <Compile Include="Views/BookI.fs" />
    <Compile Include="Views/JournalEditor.fs" />
    <Compile Include="Views/Journals.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Oxpecker" Version="2.1.1" />
  </ItemGroup>

</Project>
