{
  // Type-checks the site's plain JavaScript (JSDoc types) with TypeScript.
  // Nothing is compiled or emitted: the browser still gets the .js files as
  // written. Run `mage typecheck` (or `npx tsc -p .`); CI runs it on every PR.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "allowUnreachableCode": false,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["assets/js/*.js", "assets/types/*.d.ts"],
  "exclude": ["assets/js/*.min.js"]
}
