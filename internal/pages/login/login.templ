package login

import (
	"fmt"
	"github.com/oxri/oxri-go/internal/pages/shared"
)

templ Page(token, sshCommand, nextURL, keyComment, sshPort string) {
	@shared.Layout("Authentication - RES IMPERII", "/page-css/login.css?v=2") {
		<main class="auth-page">
			<header class="auth-header">
				@shared.BackLink("/", "Home")
				<h1>AUTHENTICATION</h1>
				<p class="auth-subtitle">Loopback SSH verification for Res Imperii</p>
			</header>
			<section class="auth-card">
				<ol class="auth-steps">
					<li>
						<span class="step-num">1</span>
						<div class="step-content">
							<p class="step-title">Open your terminal</p>
							<p class="step-desc">Use PowerShell, Windows Terminal, or your preferred shell where your SSH key or Proton Pass agent is accessible.</p>
						</div>
					</li>
					<li>
						<span class="step-num">2</span>
						<div class="step-content">
							<p class="step-title">Run the authentication command</p>
							<div class="auth-command-box" x-data="{ copied: false }">
								<code class="auth-command">{ sshCommand }</code>
								<button
									type="button"
									class="auth-copy-button"
									@click={ fmt.Sprintf("navigator.clipboard.writeText('%s'); copied = true; setTimeout(() => copied = false, 2000)", sshCommand) }
								>
									<span x-show="!copied">Copy Command</span>
									<span x-show="copied" style="display:none;">Copied!</span>
								</button>
							</div>
						</div>
					</li>
					<li>
						<span class="step-num">3</span>
						<div class="step-content">
							<p class="step-title">Identity verification</p>
							<p class="step-desc">Your private key signs the loopback challenge. Upon verification, this page automatically unlocks and returns you to the home page.</p>
						</div>
					</li>
				</ol>
				<div class="auth-status-bar">
					<span class="auth-pulse-dot"></span>
					<span class="auth-status-text">Listening on port { sshPort } · Waiting for SSH signature...</span>
				</div>
				<div class="auth-meta">
					<p>Authorized key: <code>{ keyComment }</code></p>
					<p>Alternative quick command: <code>ssh -p { sshPort } admin@localhost</code></p>
				</div>
			</section>
			<div
				id="auth-poller"
				hx-get={ fmt.Sprintf("/auth/status?token=%s&next=%s", token, nextURL) }
				hx-trigger="every 1s"
				hx-swap="none"
			></div>
		</main>
	}
}
