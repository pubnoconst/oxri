package editor

import "github.com/oxri/oxri-go/internal/pages/shared"

templ Page(isAuth bool) {
	@FormPage(isAuth, FormData{
		Published: true,
		Body:      DefaultBody,
	})
}

templ FormPage(isAuth bool, data FormData) {
	@shared.Layout(data.PageTitle(), "/page-css/journals-new.css?v=3") {
		<main class="journal-editor-page">
			<header class="journal-editor-header">
				@shared.BackLink("/journals", "Journals")
				<div class="editor-heading">
					<div>
						if data.IsEdit {
							<p class="editor-eyebrow">JOURNALS / EDIT ENTRY</p>
							<h1>Edit entry</h1>
						} else {
							<p class="editor-eyebrow">JOURNALS / NEW ENTRY</p>
							<h1>A new entry</h1>
						}
					</div>
					if isAuth {
						<p class="editor-notice">Author authenticated</p>
					} else {
						<p class="editor-notice">Draft preview · <a href="/login?next=/journals/new" style="color: inherit; text-decoration: underline;">Sign in</a></p>
					}
				</div>
			</header>

			if data.ErrorMsg != "" {
				<div class="editor-server-error" role="alert">{ data.ErrorMsg }</div>
			}

			<form id="journal-editor-form" method="POST" action={ templ.SafeURL(data.ActionURL()) } novalidate>
				<div class="journal-editor-grid">
					<section class="editor-pane editor-compose-card">
						<div class="editor-section-heading"><h2>Compose</h2><span>01</span></div>
						<div class="editor-field">
							<div class="field-label-row">
								<label for="journal-media-link">Media link</label>
								<span id="media-char-count" class="field-counter">0 / 128</span>
							</div>
							<input
								id="journal-media-link"
								name="media_url"
								type="url"
								maxlength="128"
								required
								placeholder="https://..."
								autocomplete="url"
								value={ data.MediaURL }
							/>
							<p class="field-hint">Required (1–128 chars). Video, audio, image, or X / Twitter post link.</p>
							<p id="media-error" class="field-error" aria-live="polite"></p>
						</div>
						<div class="editor-field">
							<div class="field-label-row">
								<label for="journal-tags">Tags</label>
								<span id="tags-count" class="field-counter">0 / 3</span>
							</div>
							<input
								id="journal-tags"
								name="tags"
								type="text"
								autocomplete="off"
								placeholder="Log, Dev, Note"
								value={ data.Tags }
								data-existing-tags={ data.ExistingTagsCSV() }
							/>
							<div id="tag-suggestions" class="tag-suggestions" role="listbox" aria-label="Tag suggestions"></div>
							<p class="field-hint">Up to 3 unique Title Case tags, max 4 characters each (Latin/Greek/digits only; no emojis).</p>
							<p id="tags-error" class="field-error" aria-live="polite"></p>
						</div>
						<div class="editor-field editor-content-field">
							<label for="journal-content">Entry content</label>
							<textarea id="journal-content" name="body" rows="16" required>{ data.Body }</textarea>
							<p id="body-error" class="field-error" aria-live="polite"></p>
						</div>
						if isAuth {
							<div class="editor-options">
								<label class="checkbox-label">
									<input type="checkbox" name="published" value="1" checked?={ data.Published }/>
									<span>Published (visible on public catalog)</span>
								</label>
								<label class="checkbox-label">
									<input type="checkbox" name="bookmarked" value="1" checked?={ data.Bookmarked }/>
									<span>Bookmarked</span>
								</label>
							</div>
						}
					</section>
					<section class="editor-pane editor-preview-card">
						<div class="editor-section-heading"><h2>Preview</h2><span>02</span></div>
						<article id="journal-preview" class="journal-preview">
							<div id="journal-preview-media" class="journal-preview-media" title="Media preview"></div>
							<div class="journal-preview-body">
								<div id="journal-preview-tags" class="journal-preview-tags"></div>
								<div id="journal-rendered-content" class="journal-rendered-content"></div>
							</div>
						</article>
					</section>
				</div>
				<div class="journal-editor-actions">
					if isAuth {
						<button type="submit" id="publish-submit-btn" data-is-auth="true" class="btn btn-encouraged" disabled>
							if data.IsEdit {
								Save changes
							} else {
								Publish entry
							}
						</button>
						<a href="/journals" class="btn btn-neutral">Cancel</a>
					} else {
						<p class="publish-note">Publishing requires author authentication.</p>
						<button type="button" id="publish-submit-btn" data-is-auth="false" class="btn btn-encouraged" disabled>Publish entry</button>
					}
				</div>
			</form>
		</main>
		<script src="https://cdn.jsdelivr.net/npm/markdown-it@15.0.3/dist/browser/markdown-it.umd.min.js"></script>
		<script src="https://cdn.jsdelivr.net/npm/dompurify@3.4.17/dist/purify.min.js"></script>
		<script src="https://platform.twitter.com/widgets.js" charset="utf-8" async></script>
		<script src="/assets/js/journal-media.js?v=1"></script>
		<script src="/assets/js/journal-editor.js?v=9"></script>
	}
}
