package editor

import "github.com/oxri/oxri-go/internal/pages/shared"

templ Page() {
	@shared.Layout("New Journal Entry - RES IMPERII", "/page-css/journal-editor.css?v=1") {
		<main class="journal-editor-page">
			<header class="journal-editor-header">
				@shared.BackLink("/journals", "Journals")
				<div class="editor-heading">
					<div>
						<p class="editor-eyebrow">JOURNALS / NEW ENTRY</p>
						<h1>A new entry</h1>
					</div>
					<p class="editor-notice">Draft preview - not saved</p>
				</div>
			</header>
			<div class="journal-editor-grid">
				<section class="editor-pane editor-input-card">
					<div class="editor-section-heading"><h2>Compose</h2><span>01</span></div>
					<div class="editor-field">
						<label for="journal-media-link">Media link</label>
						<input id="journal-media-link" type="url" placeholder="https://..." autocomplete="url"/>
						<p class="field-hint">Paste a video, audio, or image link to show it in the preview.</p>
					</div>
					<div class="editor-field">
						<label for="journal-tags">Tags</label>
						<input id="journal-tags" type="text" placeholder="history, notes, travel"/>
						<p class="field-hint">Separate tags with commas.</p>
					</div>
					<div class="editor-field editor-content-field">
						<label for="journal-content">Entry content</label>
						<textarea id="journal-content" rows="16"># A journal entry&#10;&#10;Write here and see it take shape in the preview.&#10;&#10;## A section&#10;&#10;Add **emphasis**, lists, links, or `inline code`.&#10;&#10;- First thought&#10;- Another thought</textarea>
					</div>
				</section>
				<section class="editor-pane editor-preview-pane">
					<div class="editor-section-heading"><h2>Live preview</h2><span>02</span></div>
					<article id="journal-preview" class="journal-preview journal-preview-card">
						<div id="journal-preview-media" class="journal-preview-media" title="Media preview"></div>
						<div class="journal-preview-body">
							<div id="journal-preview-tags" class="journal-preview-tags"></div>
							<div id="journal-rendered-content" class="journal-rendered-content"></div>
						</div>
					</article>
				</section>
			</div>
			<div class="journal-editor-actions">
				<p class="publish-note">Publishing will be available soon.</p>
				<button type="button" disabled>Publish entry</button>
			</div>
		</main>
		<script src="https://cdn.jsdelivr.net/npm/markdown-it@15.0.3/dist/browser/markdown-it.umd.min.js"></script>
		<script src="https://cdn.jsdelivr.net/npm/dompurify@3.4.17/dist/purify.min.js"></script>
		<script src="/assets/js/journal-editor.js?v=3"></script>
	}
}
