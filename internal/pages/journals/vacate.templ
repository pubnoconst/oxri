package journals

import (
	"fmt"
	"github.com/oxri/oxri-go/internal/pages/loading"
	"github.com/oxri/oxri-go/internal/pages/shared"
)

func progressMax(req int64) int64 {
	if req <= 0 {
		return 1
	}
	return req
}

func progressInitialVal(req int64) int64 {
	if req <= 0 {
		return 1
	}
	return 0
}

templ VacateSpacePage(view VacateSpaceView) {
	@shared.Layout("Make Room - RES IMPERII", "/page-css/journals.css?v=8") {
		<main class="journals-page vacate-space-page">
			<header class="journals-header">
				@shared.BackLink("/journals", "Journals")
				<div class="journals-title-row">
					<h1>Make Room</h1>
				</div>
			</header>

			<section
				id="vacate-progress-section"
				class="vacate-card vacate-summary-card"
				aria-label="Space needed"
				data-required-bytes={ fmt.Sprintf("%d", view.RequiredBytes) }
				data-entry-bytes={ fmt.Sprintf("%d", view.PendingEntryBytes) }
			>
				<p class="vacate-lead">
					Your journal archive is full. Remove a few older entries to free up at least
					<strong>{ FormatBytes(view.RequiredBytes) }</strong>,
					and your new entry will be saved automatically.
				</p>

				<div class="vacate-metrics">
					<div class="vacate-metric-item">
						<span class="vacate-metric-label">This entry</span>
						<span class="vacate-metric-value" id="vacate-entry-bytes">{ FormatBytes(view.PendingEntryBytes) }</span>
					</div>
					<div class="vacate-metric-item">
						<span class="vacate-metric-label">Space needed</span>
						<span class="vacate-metric-value" id="vacate-required-bytes">{ FormatBytes(view.RequiredBytes) }</span>
					</div>
					<div class="vacate-metric-item">
						<span class="vacate-metric-label">Archive used</span>
						<span class="vacate-metric-value">{ FormatBytes(view.UsedBytes) } of { FormatBytes(view.LimitBytes) }</span>
					</div>
				</div>

				<div class="vacate-progress-wrapper">
					<div class="vacate-progress-header">
						<span class="vacate-progress-title">Space selected</span>
						<span id="vacate-progress-readout" class="vacate-progress-readout">
							if view.RequiredBytes <= 0 {
								Enough space freed (100%)
							} else {
								0 B of { FormatBytes(view.RequiredBytes) } (0%)
							}
						</span>
					</div>
					<progress
						id="vacate-progress-bar"
						class="vacate-progress-native"
						max={ fmt.Sprintf("%d", progressMax(view.RequiredBytes)) }
						value={ fmt.Sprintf("%d", progressInitialVal(view.RequiredBytes)) }
					></progress>
					<div
						class="vacate-progress-track"
						role="progressbar"
						aria-valuemin="0"
						aria-valuemax={ fmt.Sprintf("%d", progressMax(view.RequiredBytes)) }
						aria-valuenow={ fmt.Sprintf("%d", progressInitialVal(view.RequiredBytes)) }
					>
						<div
							id="vacate-progress-fill"
							class={ "vacate-progress-fill", templ.KV("is-complete", view.RequiredBytes <= 0) }
							style={ fmt.Sprintf("width: %d%%;", view.InitialProgressPercent()) }
						></div>
					</div>
				</div>

				if view.HasPendingSubmission() {
					<form
						id="resubmit-journal-form"
						class="vacate-resubmit-form"
						method="POST"
						action={ templ.SafeURL(view.ResubmitActionURL()) }
						data-confirm-loading="true"
						data-auto-resubmit={ fmt.Sprintf("%t", view.AutoResubmitReady) }
					>
						<input type="hidden" name="media_url" value={ view.PendingSub.MediaURL }/>
						<input type="hidden" name="tags" value={ view.PendingSub.TagsRaw }/>
						<input type="hidden" name="body" value={ view.PendingSub.Body }/>
						if view.PendingSub.Published {
							<input type="hidden" name="published" value="1"/>
						}
						if view.PendingSub.Bookmarked {
							<input type="hidden" name="bookmarked" value="1"/>
						}
						<div class="vacate-resubmit-bar">
							<span class="vacate-resubmit-hint">
								if view.RequiredBytes <= 0 {
									Enough space is available — saving your entry now…
								} else {
									Your new entry is ready and will be saved automatically once you make room.
								}
							</span>
							<button
								type="submit"
								id="resubmit-entry-btn"
								class="btn btn-encouraged btn-sm"
								disabled?={ view.RequiredBytes > 0 }
							>
								Save Entry Now
							</button>
						</div>
					</form>
				}
			</section>

			<section class="vacate-card vacate-auto-card" aria-label="Make room automatically">
				<div class="vacate-auto-info">
					<h2>Make Room Automatically</h2>
					<p class="vacate-auto-desc">
						Remove older <strong>unpublished</strong> drafts first, and then older entries you haven't
						<strong>bookmarked</strong>, until there is enough room.
					</p>
					if len(view.AutoPlan.CandidateIDs) > 0 {
						<p class="vacate-auto-plan">
							This will remove <strong>{ fmt.Sprintf("%d", view.AutoPlan.UnpublishedCount) } unpublished</strong>
							and <strong>{ fmt.Sprintf("%d", view.AutoPlan.UnbookmarkedCount) } un-bookmarked</strong>
							entries, freeing <strong>{ FormatBytes(view.AutoPlan.TotalFreedBytes) }</strong>.
						</p>
					} else {
						<p class="vacate-auto-plan">
							No unpublished or un-bookmarked entries are available to remove automatically.
						</p>
					}
				</div>
				<form method="POST" action="/journals/vacate-space/" class="vacate-auto-form" data-confirm-loading="true">
					<input type="hidden" name="action" value="auto_vacate"/>
					<input type="hidden" name="required_bytes" value={ fmt.Sprintf("%d", view.RequiredBytes) }/>
					<button
						type="submit"
						id="auto-vacate-btn"
						class="btn btn-destructive"
						disabled?={ len(view.AutoPlan.CandidateIDs) == 0 }
					>
						Clear Space Automatically
					</button>
				</form>
			</section>

			<section class="vacate-card vacate-manual-card" aria-label="Choose entries to remove">
				<form id="vacate-manual-form" method="POST" action="/journals/vacate-space/" data-confirm-loading="true">
					<input type="hidden" name="action" value="delete_selected"/>
					<div class="vacate-manual-header">
						<div>
							<h2>Choose Entries to Remove</h2>
							<p class="vacate-manual-subtitle">Select entries below until the bar reaches 100%.</p>
						</div>
						<button
							type="submit"
							id="vacate-selected-btn"
							class="btn btn-destructive"
							disabled?={ view.RequiredBytes > 0 }
						>
							Remove Selected &amp; Save
						</button>
					</div>

					if len(view.Entries) == 0 {
						<p class="journals-empty">No existing journals found.</p>
					} else {
						<div class="vacate-entries-list">
							for _, item := range view.Entries {
								<label class={ "vacate-entry-row", templ.KV("is-unpublished", !item.Entry.Published) }>
									<input
										type="checkbox"
										class="vacate-entry-cb"
										name="ids"
										value={ fmt.Sprintf("%d", item.Entry.ID) }
										data-bytes={ fmt.Sprintf("%d", item.EstimatedBytes) }
										data-published={ fmt.Sprintf("%t", item.Entry.Published) }
										data-bookmarked={ fmt.Sprintf("%t", item.Entry.Bookmarked) }
									/>
									<div class="vacate-entry-main">
										<div class="vacate-entry-top">
											<span class="entry-date">{ item.FormattedDate }</span>
											<div class="journal-meta-badges">
												if !item.Entry.Published {
													<span class="entry-badge is-draft">Unpublished</span>
												} else {
													<span class="entry-badge">Published</span>
												}
												if item.Entry.Bookmarked {
													<span class="entry-badge is-bookmarked">★ Bookmarked</span>
												} else {
													<span class="entry-badge">Un-bookmarked</span>
												}
												for _, tag := range item.Tags {
													<span class="journal-tag-chip">{ tag }</span>
												}
											</div>
										</div>
										<p class="vacate-entry-excerpt">{ item.Excerpt }</p>
									</div>
									<div class="vacate-entry-size-col">
										<span class="vacate-entry-size" data-bytes={ fmt.Sprintf("%d", item.EstimatedBytes) }>
											{ item.FormattedSize }
										</span>
									</div>
								</label>
							}
						</div>
					}
				</form>
			</section>
		</main>
		@loading.Overlay(loading.DefaultPhrase, view.AutoResubmitReady)
		<script src="/assets/js/loading-transition.js?v=1"></script>
		<script src="/assets/js/vacate-space.js?v=3"></script>
	}
}
