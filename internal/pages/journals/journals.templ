package journals

import "github.com/oxri/oxri-go/internal/pages/shared"

templ Page(isAuth bool) {
	@shared.Layout("Journals - RES IMPERII", "/page-css/journals.css?v=2") {
		<main class="journals-page">
			<header class="journals-header">
				@shared.BackLink("/", "Back")
				<h1>Journals</h1>
			</header>
			<p class="journals-empty">No entries yet.</p>
			<div class="journals-actions">
				<a class="new-entry-link btn btn-neutral" href="/journals/new">Add New Entry</a>
				if isAuth {
					<a class="auth-action-link" href="/pilot/user/settings">Settings</a>
					<a class="auth-action-link" href="/logout">Sign out</a>
				} else {
					<a class="auth-action-link" href="/login">Author sign in</a>
				}
			</div>
		</main>
	}
}
