package journals

import (
	"fmt"
	"github.com/oxri/oxri-go/internal/pages/shared"
)

templ Page(isAuth bool, entries []RenderedEntry) {
	@CatalogPage(isAuth, CatalogView{
		Entries: entries,
	})
}

templ CatalogPage(isAuth bool, view CatalogView) {
	@shared.Layout("Journals - RES IMPERII", "/page-css/journals.css?v=7") {
		<main class="journals-page">
			<header class="journals-header">
				@shared.BackLink("/", "Back")
				<div class="journals-title-row">
					<h1>Journals</h1>
					<div class="journals-actions">
						<a class="new-entry-link btn btn-neutral" href="/journals/new">Add New Entry</a>
						if isAuth {
							<a class="auth-action-link" href="/logout">Sign out</a>
						} else {
							<a class="auth-action-link" href="/login?next=/journals">Author sign in</a>
						}
					</div>
				</div>
			</header>

			if len(view.Entries) > 0 || len(view.AllTags) > 0 || view.HasFilters() {
				<section class="journals-filter-bar" aria-label="Search and filter journals">
					<form class="journals-search-form" method="GET" action="/journals">
						for _, t := range view.SelectedTags {
							<input type="hidden" name="tag" value={ t }/>
						}
						<input
							type="search"
							name="q"
							class="journals-search-input"
							placeholder="Search entries…"
							value={ view.Query }
							aria-label="Search journal entries"
						/>
						<button type="submit" class="btn btn-neutral btn-sm">Search</button>
						if view.HasFilters() {
							<a href="/journals" class="filter-clear-link">Clear</a>
						}
					</form>
					if len(view.AllTags) > 0 {
						<div class="journals-tag-filters" role="group" aria-label="Filter by tag">
							<span class="tag-filter-label">Tags:</span>
							for _, tag := range view.AllTags {
								<a
									href={ templ.SafeURL(view.ToggleTagURL(tag)) }
									class={ "tag-filter-pill", templ.KV("is-active", view.IsTagSelected(tag)) }
									aria-pressed={ fmt.Sprintf("%t", view.IsTagSelected(tag)) }
								>
									{ tag }
								</a>
							}
						</div>
					}
				</section>
			}

			if isAuth && len(view.Entries) > 0 {
				<form id="batch-form" class="journals-batch-bar" method="POST" action="/journals/batch">
					<div class="batch-select-group">
						<label class="batch-select-all">
							<input type="checkbox" id="select-all-entries"/>
							<span>Select all</span>
						</label>
						<span id="selected-count" class="batch-count">0 selected</span>
					</div>
					<div class="batch-buttons">
						<button type="submit" name="action" value="publish_selected" class="btn btn-neutral btn-sm" data-requires-selection="true" disabled>Publish selected</button>
						<button type="submit" name="action" value="unpublish_selected" class="btn btn-neutral btn-sm" data-requires-selection="true" disabled>Unpublish selected</button>
						<button type="submit" name="action" value="delete_selected" class="btn btn-destructive btn-sm" data-requires-selection="true" disabled>Delete selected</button>
						<span class="batch-divider" aria-hidden="true"></span>
						<button type="submit" name="action" value="unpublish_all" class="btn btn-neutral btn-sm">Unpublish all</button>
						<button type="submit" name="action" value="delete_all" class="btn btn-destructive btn-sm">Delete all</button>
					</div>
				</form>
			}

			if len(view.Entries) == 0 {
				if view.HasFilters() {
					<p class="journals-empty">No matching entries found.</p>
				} else {
					<p class="journals-empty">No entries yet.</p>
				}
			} else {
				<div class="journals-feed is-collage-grid">
					for _, item := range view.Entries {
						@EntryCard(isAuth, item, true)
					}
				</div>
			}
		</main>
		<script src="https://platform.twitter.com/widgets.js" charset="utf-8" async></script>
		<script src="/assets/js/journal-media.js?v=1"></script>
		if isAuth {
			<script src="/assets/js/journals-catalog.js?v=1"></script>
		}
	}
}

templ EntryPage(isAuth bool, item RenderedEntry) {
	@shared.Layout("Journal Entry - RES IMPERII", "/page-css/journals.css?v=7") {
		<main class="journals-page journals-single-page">
			<header class="journals-header">
				@shared.BackLink("/journals", "Journals")
			</header>
			<div class="journals-feed journals-single">
				@EntryCard(isAuth, item, false)
			</div>
		</main>
		<script src="https://platform.twitter.com/widgets.js" charset="utf-8" async></script>
		<script src="/assets/js/journal-media.js?v=1"></script>
	}
}

templ EntryCard(isAuth bool, item RenderedEntry, isCollage bool) {
	<article class={ "journal-card", templ.KV("is-collage", isCollage), templ.KV("is-full", !isCollage), templ.KV("is-unpublished", !item.Entry.Published) }>
		<header class="journal-card-meta">
			<div class="journal-meta-left">
				if isAuth && isCollage {
					<input
						type="checkbox"
						class="entry-select-cb"
						form="batch-form"
						name="ids"
						value={ fmt.Sprintf("%d", item.Entry.ID) }
						aria-label="Select journal entry"
					/>
				}
				if isCollage {
					<a class="entry-date entry-card-link" href={ templ.SafeURL(EntryURL(item.Entry.ID)) }>{ item.FormattedDate }</a>
				} else {
					<span class="entry-date">{ item.FormattedDate }</span>
				}
			</div>
			<div class="journal-meta-badges">
				if !item.Entry.Published {
					<span class="entry-badge is-draft">Unpublished</span>
				}
				if item.Entry.Bookmarked {
					<span class="entry-badge is-bookmarked">★</span>
				}
			</div>
		</header>

		<div class="journal-media-slot journal-preview-media" data-media-url={ item.Entry.MediaURL }></div>

		if len(item.Tags) > 0 {
			<div class="journal-entry-tags">
				for _, tag := range item.Tags {
					<span class="journal-tag-chip">{ tag }</span>
				}
			</div>
		}

		if isCollage {
			<p class="journal-entry-excerpt">{ item.Excerpt }</p>
		} else {
			<div class="journal-entry-body journal-rendered-content">
				@templ.Raw(item.RenderedHTML)
			</div>
		}

		if isAuth {
			<footer class="journal-card-actions">
				<a class="btn btn-neutral btn-sm" href={ templ.SafeURL(EditURL(item.Entry.ID)) }>Edit</a>
				<form method="POST" action={ templ.SafeURL(ActionURL(item.Entry.ID, "bookmark")) }>
					<button type="submit" class="btn btn-neutral btn-sm">
						if item.Entry.Bookmarked {
							Unbookmark
						} else {
							Bookmark
						}
					</button>
				</form>
				if item.Entry.Published {
					<form method="POST" action={ templ.SafeURL(ActionURL(item.Entry.ID, "unpublish")) }>
						<button type="submit" class="btn btn-neutral btn-sm">Unpublish</button>
					</form>
				} else {
					<form method="POST" action={ templ.SafeURL(ActionURL(item.Entry.ID, "publish")) }>
						<button type="submit" class="btn btn-neutral btn-sm">Publish</button>
					</form>
				}
				<form method="POST" action={ templ.SafeURL(ActionURL(item.Entry.ID, "delete")) } onsubmit="return confirm('Delete this journal entry permanently?');">
					<button type="submit" class="btn btn-destructive btn-sm">Delete</button>
				</form>
			</footer>
		}
	</article>
}
