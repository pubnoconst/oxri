package shared

templ Layout(title, stylesheet string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="icon" type="image/png" href="/assets/favicon.png?v=1"/>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=EB+Garamond:wght@400;500;600;700&display=swap"/>
			<link rel="stylesheet" href="/assets/css/bulma.min.css"/>
			<link rel="stylesheet" href="/assets/css/overrides.css?v=22"/>
			if stylesheet != "" {
				<link rel="stylesheet" href={ stylesheet }/>
			}
		</head>
		<body>
			{ children... }
			<script src="https://unpkg.com/htmx.org@2.0.4"></script>
			<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.8/dist/cdn.min.js"></script>
			<script src="/assets/js/theme-toggle.js?v=1"></script>
			<script src="/assets/js/navigation-feedback.js?v=1"></script>
		</body>
	</html>
}

templ BackLink(href, label string) {
	<a class="back-link" href={ templ.SafeURL(href) }>
		<span class="back-icon" aria-hidden="true"></span>
		<span class="back-label">{ label }</span>
	</a>
}
