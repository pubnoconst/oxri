# Res Imperii - Environment Configuration
# Store your actual secrets in ../oxri-parent/db.env (outside the Git repository).

# Web Server
PORT=8080
ADDR=127.0.0.1:8080

# SSH Loopback Authentication
SSH_PORT=2222
SSH_ADDR=127.0.0.1:2222
ADMIN_SSH_PUBKEY=ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI...
HOST_KEY_PATH=../oxri-parent/.ssh_host_key

# Database (Turso Cloud only; local file databases are disabled)
TURSO_DATABASE_URL=libsql://your-db-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
TURSO_MAX_STORAGE_BYTES=4500000000
