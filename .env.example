# Res Imperii - Environment Configuration
# Web Server
PORT=8080
ADDR=127.0.0.1:8080

# SSH Loopback Authentication
SSH_PORT=2222
SSH_ADDR=127.0.0.1:2222
ADMIN_SSH_PUBKEY=ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAILGeK+yBmZxTOmOW/qnIO9ErziQ7i3KyeBpnt3Ns0sc8
HOST_KEY_PATH=.ssh_host_key

# Database (Turso / libSQL or local SQLite)
# Stored in db.env or .env (untracked)
TURSO_DATABASE_URL=libsql://your-db-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
